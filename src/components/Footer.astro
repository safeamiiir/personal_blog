---
import { MY_NAME } from "../config";

// The blog started in 2023; the end year is set at build time.
const START_YEAR = 2023;
const year = new Date().getFullYear();
---

<footer class="text-xs leading-[1.5]">
  <div>
    © {START_YEAR}–{year} {MY_NAME} · <a href="/rss.xml">RSS</a> ·
    <a href="/privacy">Privacy</a> ·
    <button type="button" id="cookie-settings" class="underline">Cookie settings</button>
  </div>
</footer>

<script>
  import { setConsent } from "../lib/consent";

  // Clearing the choice brings the cookie banner back.
  document
    .getElementById("cookie-settings")
    ?.addEventListener("click", () => setConsent(null));
</script>

<style>
  footer {
    grid-area: footer;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
