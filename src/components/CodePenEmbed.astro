---
import ExternalEmbed from "./ExternalEmbed.astro";

type Props = {
  url: string;
  title: string;
  data_slug_hash: string;
  data_user: string;
};

const { title, data_slug_hash, data_user } = Astro.props;

// Plain iframe instead of CodePen's ei.js script, so less third-party code runs on the page.
const embedUrl = `https://codepen.io/${data_user}/embed/${data_slug_hash}?default-tab=html%2Cresult`;
---

<ExternalEmbed
  provider="CodePen"
  privacyUrl="https://blog.codepen.io/documentation/privacy/"
  label="CodePen"
>
  <iframe
    class="w-full"
    height="300"
    style="border: 0;"
    src={embedUrl}
    title={title}
    loading="lazy"
    allowfullscreen
  >
  </iframe>
</ExternalEmbed>
